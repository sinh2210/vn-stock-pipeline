# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=vnstock
POSTGRES_PASSWORD=vnstock123
POSTGRES_DB=vnstock_db

# Connection string used inside containers (hostname = service name in Compose)
DATABASE_URL=postgresql://vnstock:vnstock123@db:5432/vnstock_db

# ── Ingestion ─────────────────────────────────────────────────────────────
# Comma-separated ticker list (HOSE blue chips)
TICKERS=VCB,TCB,BID,HPG,VNM,FPT,VHM,MSN,GAS,SSI

# Initial backfill start date (YYYY-MM-DD)
START_DATE=2023-01-01
